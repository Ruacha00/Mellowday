# MellowDay configuration. Copy to .env; the file is git-ignored.
#
# Only the credential belongs here. Model and endpoint deliberately have no
# entries so the in-app settings page stays authoritative for them; the
# defaults already match the endpoint below.
MELLOWDAY_API_KEY=

# Optional overrides (a real process environment variable always wins):
# MELLOWDAY_API_BASE=https://api.deepseek.com
# MELLOWDAY_MODEL=deepseek-v4-pro
# MELLOWDAY_DATA_DIR=
# MELLOWDAY_ENV_FILE=            # set empty to disable .env loading entirely
