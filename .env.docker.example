# Host-side environment for the Docker deployment.
#
#   cp .env.docker.example .env
#
# This file is read by docker compose (for ${VAR} interpolation) and passed into
# the container as an env_file. It never enters the image: .dockerignore excludes
# .env and .env.*, and the Dockerfile copies only pyproject.toml and src/.

# Required for chat. The container reports model_configured=false without it and
# /api/chat answers with a configuration error instead of opening a stream.
MELLOWDAY_API_KEY=

# Optional. Empty means "use the application default"
# (https://api.deepseek.com and deepseek-v4-pro, see src/mellowday/config.py).
# They are forwarded explicitly so a deployment can point at another
# OpenAI-compatible endpoint without rebuilding.
MELLOWDAY_API_BASE=
MELLOWDAY_MODEL=

# Host port for the web interface. The container always listens on 8000 and the
# published port is bound to 127.0.0.1 only.
MELLOWDAY_WEB_PORT=8021

# MELLOWDAY_DATA_DIR is NOT set here on purpose: inside the container it is
# always /app/data, backed by the named volume "mellowday-data".
