            description="Permanently delete a Reminder.",
            input_schema=reminder_id_schema,
            executor=delete,
            permission_requirements=("reminders:delete",),
            side_effect="irreversible",
            risk="medium",
        ),
    )


def _reminder_result(reminder: Reminder | None) -> dict[str, object]:
