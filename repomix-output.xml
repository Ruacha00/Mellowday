<file path="src/mellowday/web_app/static/index.html">
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f1eadc" />
    <title>Mellowday · Conversation</title>
    <link rel="stylesheet" href="/static/styles.css" />
    <script src="/static/app.js" defer></script>
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <main class="conversation-shell">
      <header class="masthead">
        <div class="wordmark">
          <span class="sun-mark" aria-hidden="true"></span>
          <div>
            <p class="eyebrow">Your local companion</p>
            <h1>Mellowday</h1>
          </div>
        </div>
        <div class="masthead-actions">
          <p class="day-note">A quiet place for what’s on your mind.</p>
          <button
            id="settings-toggle"
            class="management-button"
            type="button"
            aria-controls="settings-panel"
            aria-expanded="false"
          >Settings</button>
        </div>
      </header>

      <section
        id="conversation-view"
        class="view-panel conversation"
        aria-labelledby="conversation-title"
      >
        <div class="conversation-heading">
          <div>
            <p class="section-number">01 / Conversation</p>
            <h2 id="conversation-title">Take your time.</h2>
          </div>
          <span class="local-badge">Local · Fake Provider</span>
        </div>

        <ol id="messages" class="messages" aria-live="polite" aria-relevant="additions">
          <li class="welcome-note">
            <span aria-hidden="true">悠</span>
            <p>Start anywhere. Say hello, share a thought, or simply see where the moment goes.</p>
          </li>
        </ol>

        <form id="conversation-form" class="composer">
          <label for="message-input">Message</label>
          <div class="composer-row">
            <textarea
              id="message-input"
              name="message"
              rows="1"
              placeholder="Write what’s on your mind…"
              autocomplete="off"
              required
            ></textarea>
            <button type="submit">
              <span>Send</span>
              <span class="arrow" aria-hidden="true">↗</span>
            </button>
          </div>
          <p id="composer-status" class="composer-status" role="status">Ready when you are.</p>
        </form>
      </section>

      <section
        id="settings-panel"
        class="settings-panel"
        aria-labelledby="settings-title"
        hidden
      >
        <header class="settings-heading">
          <div>
            <p class="section-number">02 / Settings</p>
            <h2 id="settings-title">Settings</h2>
            <p class="settings-intro">
              Review local history, extension metadata, confirmations, and
              runtime records. Management copy remains neutral and precise.
            </p>
          </div>
          <button id="settings-close" class="management-button" type="button">
            Back to conversation
          </button>
        </header>

        <p id="settings-status" class="settings-status" role="status"></p>

        <section id="daily-review" class="task-settings" aria-labelledby="daily-review-title">
          <header class="history-settings-heading">
            <div>
              <p class="operation-kicker">Derived from current Life Records</p>
              <h3 id="daily-review-title">Daily Review</h3>
              <p id="daily-review-metadata" class="capability-description"></p>
            </div>
            <button id="refresh-daily-review" class="management-button" type="button">
              Refresh review
            </button>
          </header>
          <div id="daily-review-sections" class="daily-review-sections" aria-live="polite"></div>
        </section>

        <section class="operations-dashboard" aria-labelledby="service-status-title">
          <header class="history-settings-heading">
            <div>
              <p class="operation-kicker">Local operations</p>
              <h3 id="service-status-title">Service status</h3>
              <p class="capability-description">
                Inspect the backend, selected Provider, and recent runtime activity.
              </p>
            </div>
            <button id="refresh-operations" class="text-button" type="button">
              Refresh operations
            </button>
          </header>

          <dl id="service-status" class="operation-summary">
            <div><dt>Backend</dt><dd id="backend-status">Loading</dd></div>
            <div><dt>Provider</dt><dd id="provider-status">Loading</dd></div>
            <div><dt>Sessions</dt><dd id="session-status">Loading</dd></div>
          </dl>

          <div class="operations-grid">
            <section class="operation-console" aria-labelledby="runtime-events-title">
              <h4 id="runtime-events-title">Runtime events</h4>
              <div class="operation-filters">
                <label>
                  <span>Event type</span>
                  <select id="event-type-filter">
                    <option value="">All event types</option>
                    <option value="turn_completed">turn_completed</option>
                    <option value="provider_failed">provider_failed</option>
                    <option value="confirmation_pending">confirmation_pending</option>
                    <option value="confirmation_accepted">confirmation_accepted</option>
                    <option value="confirmation_rejected">confirmation_rejected</option>
                  </select>
                </label>
                <label>
                  <span>Conversation</span>
                  <input id="event-conversation-filter" autocomplete="off" />
                </label>
                <button id="refresh-events" class="text-button" type="button">
                  Refresh runtime events
                </button>
              </div>
              <ol id="runtime-event-list" class="runtime-list"></ol>
            </section>

            <section class="operation-console" aria-labelledby="runtime-logs-title">
              <h4 id="runtime-logs-title">Runtime logs</h4>
              <div class="operation-filters">
                <label>
                  <span>Minimum log level</span>
                  <select id="log-level-filter">
                    <option value="">All levels</option>
                    <option value="WARNING">WARNING</option>
                    <option value="ERROR">ERROR</option>
                    <option value="CRITICAL">CRITICAL</option>
                  </select>
                </label>
                <label>
                  <span>Log search</span>
                  <input id="log-search-filter" type="search" autocomplete="off" />
                </label>
                <button id="refresh-logs" class="text-button" type="button">
                  Refresh runtime logs
                </button>
              </div>
              <ol id="runtime-log-list" class="runtime-list"></ol>
            </section>
          </div>

          <form id="diagnostic-form" class="diagnostic-form">
            <label for="diagnostic-message">Diagnostic input</label>
            <textarea id="diagnostic-message" rows="2" required></textarea>
            <button type="submit">Run diagnostic probe</button>
            <div id="diagnostic-result" aria-label="Diagnostic result"></div>
          </form>
        </section>

        <section class="task-settings" aria-labelledby="memory-settings-title">
          <header class="history-settings-heading">
            <div>
              <p class="operation-kicker">Durable User information</p>
              <h3 id="memory-settings-title">Memory</h3>
              <p class="capability-description">
                Inspect and correct durable preferences, facts, and important matters.
                Memory remains separate from Conversation History and Life Records.
              </p>
            </div>
            <span class="local-badge">Local Memory</span>
          </header>

          <form id="memory-form" class="task-form" hidden>
            <input name="memory_id" type="hidden" />
            <label>
              <span>Memory content</span>
              <textarea name="content" rows="3" required aria-label="Memory content"></textarea>
            </label>
            <label>
              <span>Memory kind</span>
              <select name="kind" aria-label="Memory kind">
                <option value="preference">Preference</option>
                <option value="fact">Fact</option>
                <option value="important">Important matter</option>
              </select>
            </label>
            <div class="task-form-actions">
              <button type="submit">Save Memory</button>
              <button id="cancel-memory-edit" class="text-button" type="button">
                Cancel edit
              </button>
            </div>
          </form>
          <label class="note-search">
            <span>Search Memory</span>
            <input
              id="memory-search"
              type="search"
              autocomplete="off"
              aria-label="Search Memory"
            />
          </label>
          <div id="memory-list" class="task-list" aria-live="polite"></div>
        </section>

        <section class="task-settings" aria-labelledby="task-settings-title">
          <header class="history-settings-heading">
            <div>
              <p class="operation-kicker">Life Records</p>
              <h3 id="task-settings-title">Tasks</h3>
              <p class="capability-description">
                Track work and completion here. Deadlines do not create Reminders.
              </p>
            </div>
            <span class="local-badge">Local Tasks</span>
          </header>

          <form id="task-form" class="task-form">
            <input name="task_id" type="hidden" />
            <label>
              <span>Task title</span>
              <input name="title" autocomplete="off" required aria-label="Task title" />
            </label>
            <label>
              <span>Task details</span>
              <textarea name="details" rows="2" aria-label="Task details"></textarea>
            </label>
            <label>
              <span>Task deadline</span>
              <input name="deadline" type="date" aria-label="Task deadline" />
            </label>
            <div class="task-form-actions">
              <button type="submit">Add Task</button>
              <button id="cancel-task-edit" class="text-button" type="button" hidden>
                Cancel edit
              </button>
            </div>
          </form>
          <div id="task-list" class="task-list" aria-live="polite"></div>
        </section>

        <section class="task-settings" aria-labelledby="note-settings-title">
          <header class="history-settings-heading">
            <div>
              <p class="operation-kicker">Life Records</p>
              <h3 id="note-settings-title">Notes</h3>
              <p class="capability-description">
                Preserve free-form content deliberately. Notes remain separate from Memory.
              </p>
            </div>
            <span class="local-badge">Local Notes</span>
          </header>

          <form id="note-form" class="task-form">
            <input name="note_id" type="hidden" />
            <label>
              <span>Note title (optional)</span>
              <input name="title" autocomplete="off" aria-label="Note title" />
            </label>
            <label>
              <span>Note content</span>
              <textarea name="content" rows="4" required aria-label="Note content"></textarea>
            </label>
            <div class="task-form-actions">
              <button type="submit">Add Note</button>
              <button id="cancel-note-edit" class="text-button" type="button" hidden>
                Cancel edit
              </button>
            </div>
          </form>
          <label class="note-search">
            <span>Search Notes</span>
            <input id="note-search" type="search" autocomplete="off" aria-label="Search Notes" />
          </label>
          <div id="note-list" class="task-list" aria-live="polite"></div>
        </section>

        <section class="task-settings" aria-labelledby="reminder-settings-title">
          <header class="history-settings-heading">
            <div>
              <p class="operation-kicker">Life Records</p>
              <h3 id="reminder-settings-title">Reminders</h3>
              <p class="capability-description">
                Schedule notifications independently from Task completion.
              </p>
            </div>
            <span class="local-badge">Local Reminders</span>
          </header>

          <form id="reminder-form" class="task-form">
            <input name="reminder_id" type="hidden" />
            <label>
              <span>Reminder text</span>
              <input name="message" autocomplete="off" required aria-label="Reminder text" />
            </label>
            <label>
              <span>Reminder due time</span>
              <input name="due_at" type="datetime-local" required aria-label="Reminder due time" />
            </label>
            <label>
              <span>Linked Task ID (optional)</span>
              <input name="task_id" autocomplete="off" aria-label="Linked Task ID" />
            </label>
            <div class="task-form-actions">
              <button type="submit">Add Reminder</button>
              <button id="cancel-reminder-edit" class="text-button" type="button" hidden>
                Cancel edit
              </button>
            </div>
          </form>
          <div id="reminder-list" class="task-list" aria-live="polite"></div>
        </section>

        <section class="task-settings" aria-labelledby="calendar-event-settings-title">
          <header class="history-settings-heading">
            <div>
              <p class="operation-kicker">Life Records</p>
              <h3 id="calendar-event-settings-title">Calendar Events</h3>
              <p class="capability-description">
                Reserve time explicitly. Calendar Events do not create Tasks or Reminders.
              </p>
            </div>
            <span class="local-badge">Local Calendar</span>
          </header>

          <form id="calendar-event-form" class="task-form">
            <input name="event_id" type="hidden" />
            <label>
              <span>Calendar Event title</span>
              <input name="title" autocomplete="off" required aria-label="Calendar Event title" />
            </label>
            <label>
              <span>Calendar Event start time</span>
              <input name="start_at" type="datetime-local" required aria-label="Calendar Event start time" />
            </label>
            <label>
              <span>Calendar Event end time (optional)</span>
              <input name="end_at" type="datetime-local" aria-label="Calendar Event end time" />
            </label>
            <label>
              <span>Calendar Event details (optional)</span>
              <textarea name="details" rows="2" aria-label="Calendar Event details"></textarea>
            </label>
            <div class="task-form-actions">
              <button type="submit">Add Calendar Event</button>
              <button id="cancel-calendar-event-edit" class="text-button" type="button" hidden>
                Cancel edit
              </button>
            </div>
          </form>
