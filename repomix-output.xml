.capability-card {
  padding: 19px 20px;
  border: 1px solid var(--line);
  border-left: 3px solid var(--vermillion);
  background: rgba(255, 255, 255, 0.5);
}

.confirmation-card {
  border-left-color: var(--ink);
  background:
    linear-gradient(110deg, rgba(23, 56, 47, 0.045), transparent 48%),
    rgba(255, 255, 255, 0.56);
}

.confirmation-heading,
.confirmation-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.confirmation-expiry,
.confirmation-context {
  color: var(--ink-soft);
  font-size: 0.72rem;
}

.confirmation-context {
  margin: 10px 0 0;
}

.confirmation-actions {
  justify-content: flex-end;
  margin-top: 16px;
}

.decision-button {
  min-width: 92px;
  min-height: 38px;
  padding: 0 14px;
}

.decision-reject {
  color: var(--vermillion);
  border: 1px solid rgba(198, 75, 54, 0.5);
  background: transparent;
}

.decision-reject:hover:not(:disabled) {
  color: var(--paper-light);
}

.decision-accept {
  background: var(--ink);
}

.decision-accept:hover:not(:disabled) {
  background: #0e2b23;
}

.audit-list {
  display: grid;
  max-height: 354px;
  gap: 1px;
  margin: 0;
  padding: 0;
  overflow-y: auto;
  list-style: none;
  background: var(--line);
  border: 1px solid var(--line);
}

.audit-event {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 5px 12px;
  padding: 12px 14px;
  background: rgba(251, 247, 238, 0.94);
}

.audit-event code {
  min-width: 0;
  overflow: hidden;
  color: var(--ink);
  font-size: 0.73rem;
  text-overflow: ellipsis;
}

.audit-event span,
.audit-event time {
  color: var(--ink-soft);
  font-size: 0.66rem;
}

.audit-event span {
  grid-column: 1;
}

.audit-event time {
  grid-column: 2;
  grid-row: 1 / span 2;
}

.audit-undo {
  grid-column: 1 / -1;
  margin-top: 5px;
  color: var(--ink-soft);
  font-size: 0.68rem;
}

.audit-undo summary {
  color: var(--vermillion);
  cursor: pointer;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.audit-undo pre {
  margin: 9px 0 0;
  padding: 10px;
  overflow-x: auto;
  background: rgba(23, 56, 47, 0.06);
  font-size: 0.68rem;
}

.capability-name {
  color: var(--ink);
  font: 700 0.82rem/1.3 "Cascadia Mono", "SFMono-Regular", Consolas, monospace;
}

.capability-description {
  margin: 9px 0 15px;
  color: var(--ink-soft);
  font-size: 0.9rem;
  line-height: 1.5;
}

.capability-facts {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 0;
}

.capability-facts div {
  padding: 7px 9px;
  border: 1px solid var(--line);
  background: var(--paper-light);
}

.capability-facts dt,
.capability-facts dd {
  display: inline;
  margin: 0;
  font-size: 0.7rem;
}

.capability-facts dt {
  color: var(--ink-soft);
  text-transform: uppercase;
}

.capability-facts dt::after {
  content: " / ";
  color: var(--vermillion);
}

.schema-detail {
  margin-top: 14px;
  color: var(--ink-soft);
  font-size: 0.76rem;
}

.schema-detail summary {
  cursor: pointer;
}

.schema-detail pre {
  max-height: 220px;
  margin: 10px 0 0;
  padding: 12px;
  overflow: auto;
  background: rgba(23, 56, 47, 0.06);
  font-size: 0.7rem;
}

.skill-card {
  align-items: flex-start;
  gap: 18px;
}

.skill-enablement {
  flex: 0 0 auto;
  justify-content: flex-start;
  gap: 8px;
  cursor: pointer;
}

.skill-enablement input {
  position: relative;
  width: 34px;
  height: 19px;
  flex: 0 0 auto;
  margin: 0;
  appearance: none;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: rgba(23, 56, 47, 0.1);
  cursor: pointer;
  transition: background 180ms ease;
}

.skill-enablement input::after {
  position: absolute;
  top: 3px;
  left: 3px;
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: var(--ink-soft);
  content: "";
  transition: transform 180ms ease, background 180ms ease;
}

.skill-enablement input:checked {
  background: rgba(198, 75, 54, 0.16);
}

.skill-enablement input:checked::after {
  background: var(--vermillion);
  transform: translateX(15px);
}

.skill-enablement input:focus-visible {
  outline: 2px solid var(--vermillion);
  outline-offset: 2px;
}

.skill-state,
.empty-capability {
  color: var(--ink-soft);
  font-size: 0.72rem;
}

.empty-capability {
  padding: 22px 0;
  border-top: 1px solid var(--line);
}

.operations-dashboard {
  margin-top: 24px;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.34);
}

.operation-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin: 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.operation-summary div {
  padding: 16px 22px;
  border-right: 1px solid var(--line);
}

.operation-summary div:last-child {
  border-right: 0;
}

.operation-summary dt,
.operation-filters span,
.diagnostic-form > label {
  color: var(--ink-soft);
  font-size: 0.68rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.operation-summary dd {
  margin: 5px 0 0;
  font-weight: 700;
}

.operations-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.operation-console {
  min-width: 0;
  padding: 22px;
  border-right: 1px solid var(--line);
}

.operation-console:last-child {
  border-right: 0;
}

.operation-console h4,
.recent-confirmations-title {
  margin: 0 0 14px;
}

.operation-filters {
  display: grid;
  gap: 9px;
}

.operation-filters label {
  display: grid;
  gap: 4px;
}

.operation-filters input,
.operation-filters select,
.diagnostic-form textarea {
  box-sizing: border-box;
  width: 100%;
  border: 1px solid var(--line);
  background: var(--paper-light);
  color: var(--ink);
  font: inherit;
}

.runtime-list {
  max-height: 230px;
  margin: 16px 0 0;
  padding: 0;
  overflow: auto;
  list-style: none;
}

.runtime-record {
  display: grid;
  grid-template-columns: minmax(110px, auto) 1fr auto;
  gap: 10px;
  margin: 0;
  padding: 9px 0;
  border-top: 1px solid var(--line);
  color: var(--ink-soft);
  font-size: 0.74rem;
}

.diagnostic-form {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 9px 14px;
  padding: 22px;
  border-top: 1px solid var(--line);
}

.diagnostic-form > label,
.diagnostic-form #diagnostic-result {
  grid-column: 1 / -1;
}

.diagnostic-form #diagnostic-result {
  min-height: 1.4em;
  color: var(--ink-soft);
  font-size: 0.82rem;
}

@keyframes settle {
  from { opacity: 0; transform: translateY(18px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes message-in {
  from { opacity: 0; transform: translateY(9px) scale(0.99); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@media (max-width: 680px) {
  .conversation-shell {
    width: min(100% - 20px, 1120px);
    padding: 22px 0 16px;
  }

  .day-note,
  .local-badge {
    display: none;
  }

  .masthead-actions {
    gap: 0;
  }

  .conversation {
    min-height: calc(100vh - 100px);
    border-radius: 2px 28px 2px 2px;
  }

  .masthead-actions {
    gap: 0;
  }

  .history-settings-heading,
  .history-index,
  .history-detail,
  .settings-status {
    padding-right: 0;
    padding-left: 0;
  }

  .settings-grid {
    grid-template-columns: 1fr;
  }

  .history-index {
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  .history-detail-heading {
    flex-direction: column;
  }

  .persona-form {
    grid-template-columns: 1fr;
  }

  .provider-form,
  .provider-list,
  .task-form,
  .task-list {
    grid-template-columns: 1fr;
  }

  .conversation-heading,
  .messages,
  .composer {
    padding-right: 20px;
    padding-left: 20px;
  }

  .messages {
    max-height: calc(100vh - 340px);
  }

  .composer-row {
    flex-direction: column;
  }

  .settings-panel {
    min-height: calc(100vh - 100px);
    padding: 24px 20px;
    border-radius: 2px 28px 2px 2px;
  }

  .settings-heading,
  .skill-card {
    align-items: flex-start;
    flex-direction: column;
  }

  .capability-columns {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .settings-operations {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .operation-summary,
  .operations-grid {
    grid-template-columns: 1fr;
  }

  .operation-summary div,
  .operation-console {
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  .diagnostic-form {
    grid-template-columns: 1fr;
  }

  button {
    min-height: 48px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
